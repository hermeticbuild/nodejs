+#ifndef SRC_NODE_HERMETIC_POLICY_H_
+#define SRC_NODE_HERMETIC_POLICY_H_
+
+#if defined(NODE_WANT_INTERNALS) && NODE_WANT_INTERNALS
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "node_exit_code.h"
+
+namespace node::hermetic {
+
+enum class MountAccess { kReadOnly, kReadWrite };
+
+struct Mount {
+  std::string path;
+  uint64_t handle;
+  MountAccess access;
+};
+
+struct Policy {
+  uint64_t version;
+  std::vector<Mount> mounts;
+  std::string cwd;
+  std::string exec_path;
+};
+
+ExitCode InitializePolicy(const std::vector<std::string>& args,
+                          std::vector<std::string>* errors);
+bool HasPolicyOption(const std::vector<std::string>& args);
+const Policy* GetPolicy();
+
+}  // namespace node::hermetic
+
+#endif  // defined(NODE_WANT_INTERNALS) && NODE_WANT_INTERNALS
+
+#endif  // SRC_NODE_HERMETIC_POLICY_H_
