diff --git a/src/node_hermetic_policy.cc b/src/node_hermetic_policy.cc
new file mode 100644
index 00000000..e688b01c
--- /dev/null
+++ b/src/node_hermetic_policy.cc
@@ -0,0 +1,229 @@
+#include "node_hermetic_policy.h"
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <utility>
+
+#include "node_options.h"
+#include "simdjson.h"
+#include "uv.h"
+
+namespace node::hermetic {
+
+namespace {
+
+constexpr std::string_view kPolicyOption = "--hermetic-policy-handle";
+constexpr std::string_view kPolicyFlag = "--hermetic-policy-handle=";
+constexpr size_t kReadSize = 8192;
+constexpr size_t kMaxPolicySize = 1024 * 1024;
+
+std::unique_ptr<const Policy> policy;
+
+bool IsPolicyOption(std::string_view arg) {
+  return arg == kPolicyOption || arg.starts_with(kPolicyFlag);
+}
+
+std::optional<uint64_t> FindPolicyHandle(
+    const std::vector<std::string>& args,
+    std::vector<std::string>* errors) {
+  std::vector<std::string> parsed_args = args;
+  std::vector<std::string> exec_args;
+  std::vector<std::string> v8_args;
+  std::vector<std::string> parse_errors;
+  PerProcessOptions parsed_options;
+  options_parser::Parse(&parsed_args,
+                        &exec_args,
+                        &v8_args,
+                        &parsed_options,
+                        kDisallowedInEnvvar,
+                        &parse_errors);
+
+  bool found = false;
+  for (const std::string& arg : exec_args) {
+    if (IsPolicyOption(arg)) {
+      if (found) {
+        errors->emplace_back("--hermetic-policy-handle may only be specified "
+                             "once");
+        return std::nullopt;
+      }
+      found = true;
+    }
+  }
+
+  if (!found) return std::nullopt;
+  if (!parse_errors.empty()) {
+    errors->insert(errors->end(), parse_errors.begin(), parse_errors.end());
+    return std::nullopt;
+  }
+  if (parsed_options.hermetic_policy_handle >
+      static_cast<uint64_t>(std::numeric_limits<uv_file>::max())) {
+    errors->emplace_back("--hermetic-policy-handle must identify an open "
+                         "file descriptor");
+    return std::nullopt;
+  }
+  return parsed_options.hermetic_policy_handle;
+}
+
+int ReadPolicy(uv_file handle, std::string* contents) {
+  uv_fs_t request;
+  while (contents->size() < kMaxPolicySize) {
+    const size_t offset = contents->size();
+    const size_t read_size = std::min(kReadSize, kMaxPolicySize - offset);
+    contents->resize(offset + read_size);
+    uv_buf_t buffer = uv_buf_init(contents->data() + offset, read_size);
+    const int read =
+        uv_fs_read(nullptr, &request, handle, &buffer, 1, -1, nullptr);
+    uv_fs_req_cleanup(&request);
+    if (read < 0) return read;
+    contents->resize(offset + read);
+    if (read == 0) return 0;
+  }
+
+  char extra;
+  uv_buf_t buffer = uv_buf_init(&extra, 1);
+  const int read = uv_fs_read(nullptr, &request, handle, &buffer, 1, -1, nullptr);
+  uv_fs_req_cleanup(&request);
+  if (read < 0) return read;
+  return read == 0 ? 0 : UV_EFBIG;
+}
+
+bool ReadString(simdjson::dom::object object,
+                std::string_view name,
+                std::string* value) {
+  std::string_view parsed;
+  if (object[name].get_string().get(parsed)) return false;
+  value->assign(parsed);
+  return true;
+}
+
+bool IsOpenHandle(uint64_t handle) {
+  if (handle > static_cast<uint64_t>(std::numeric_limits<uv_file>::max())) {
+    return false;
+  }
+  uv_fs_t request;
+  const int result = uv_fs_fstat(
+      nullptr, &request, static_cast<uv_file>(handle), nullptr);
+  uv_fs_req_cleanup(&request);
+  return result == 0;
+}
+
+std::unique_ptr<const Policy> ParsePolicy(std::string& contents,
+                                          std::vector<std::string>* errors) {
+  simdjson::dom::parser parser;
+  simdjson::dom::element document;
+  if (parser.parse(simdjson::pad(contents)).get(document)) {
+    errors->emplace_back("cannot parse hermetic policy manifest");
+    return nullptr;
+  }
+
+  simdjson::dom::object object;
+  if (document.get_object().get(object)) {
+    errors->emplace_back("hermetic policy manifest must be an object");
+    return nullptr;
+  }
+
+  uint64_t version;
+  if (object["version"].get_uint64().get(version) || version != 1) {
+    errors->emplace_back("unsupported hermetic policy manifest version");
+    return nullptr;
+  }
+
+  std::string cwd;
+  std::string exec_path;
+  if (!ReadString(object, "cwd", &cwd) ||
+      !ReadString(object, "execPath", &exec_path)) {
+    errors->emplace_back(
+        "hermetic policy manifest requires string cwd and execPath fields");
+    return nullptr;
+  }
+
+  simdjson::dom::array raw_mounts;
+  if (object["mounts"].get_array().get(raw_mounts)) {
+    errors->emplace_back("hermetic policy manifest requires a mounts array");
+    return nullptr;
+  }
+
+  std::vector<Mount> mounts;
+  for (simdjson::dom::element raw_mount : raw_mounts) {
+    simdjson::dom::object mount;
+    if (raw_mount.get_object().get(mount)) {
+      errors->emplace_back("hermetic policy mounts must be objects");
+      return nullptr;
+    }
+
+    std::string path;
+    std::string access;
+    uint64_t handle;
+    if (!ReadString(mount, "path", &path) ||
+        mount["handle"].get_uint64().get(handle) ||
+        !ReadString(mount, "access", &access)) {
+      errors->emplace_back(
+          "hermetic policy mounts require path, handle, and access fields");
+      return nullptr;
+    }
+    if (!IsOpenHandle(handle)) {
+      errors->emplace_back(
+          "hermetic policy mount handle must identify an open file descriptor");
+      return nullptr;
+    }
+
+    MountAccess parsed_access;
+    if (access == "read-only") {
+      parsed_access = MountAccess::kReadOnly;
+    } else if (access == "read-write") {
+      parsed_access = MountAccess::kReadWrite;
+    } else {
+      errors->emplace_back(
+          "hermetic policy mount access must be read-only or read-write");
+      return nullptr;
+    }
+    mounts.push_back({std::move(path), handle, parsed_access});
+  }
+
+  return std::make_unique<const Policy>(
+      Policy{version, std::move(mounts), std::move(cwd), std::move(exec_path)});
+}
+
+}  // namespace
+
+bool HasPolicyOption(const std::vector<std::string>& args) {
+  for (const std::string& arg : args) {
+    if (arg == "--") return false;
+    if (IsPolicyOption(arg)) return true;
+  }
+  return false;
+}
+
+ExitCode InitializePolicy(const std::vector<std::string>& args,
+                          std::vector<std::string>* errors) {
+  const size_t original_error_count = errors->size();
+  const std::optional<uint64_t> handle = FindPolicyHandle(args, errors);
+  if (errors->size() != original_error_count) {
+    return ExitCode::kInvalidCommandLineArgument;
+  }
+  if (!handle.has_value()) return ExitCode::kNoFailure;
+
+  std::string contents;
+  const int read_error = ReadPolicy(static_cast<uv_file>(*handle), &contents);
+  uv_fs_t request;
+  const int close_error =
+      uv_fs_close(nullptr, &request, static_cast<uv_file>(*handle), nullptr);
+  uv_fs_req_cleanup(&request);
+  if (read_error != 0 || close_error != 0) {
+    errors->emplace_back("cannot read hermetic policy manifest handle");
+    return ExitCode::kInvalidCommandLineArgument;
+  }
+
+  policy = ParsePolicy(contents, errors);
+  if (policy == nullptr) return ExitCode::kInvalidCommandLineArgument;
+  return ExitCode::kNoFailure;
+}
+
+const Policy* GetPolicy() {
+  return policy.get();
+}
+
+}  // namespace node::hermetic
