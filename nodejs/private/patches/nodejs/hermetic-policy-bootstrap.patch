diff --git a/test/parallel/test-cli-hermetic-policy.js b/test/parallel/test-cli-hermetic-policy.js
new file mode 100644
index 00000000..d12ce744
--- /dev/null
+++ b/test/parallel/test-cli-hermetic-policy.js
@@ -0,0 +1,111 @@
+'use strict';
+
+const tmpdir = require('../common/tmpdir');
+const assert = require('node:assert');
+const fs = require('node:fs');
+const { spawnSync } = require('node:child_process');
+
+tmpdir.refresh();
+
+const validManifest = {
+  version: 1,
+  mounts: [{
+    path: '/workspace',
+    handle: 4,
+    access: 'read-only',
+  }],
+  cwd: '/workspace',
+  execPath: '/node/bin/node',
+};
+
+function spawnWithManifest(manifest, args = [], options = {}) {
+  const manifestPath = tmpdir.resolve('manifest.json');
+  const mountPath = tmpdir.resolve('mount');
+  fs.writeFileSync(manifestPath, manifest);
+  fs.writeFileSync(mountPath, '');
+  const manifestHandle = fs.openSync(manifestPath, 'r');
+  const mountHandle = fs.openSync(mountPath, 'r');
+  const result = spawnSync(process.execPath, [
+    '--hermetic-policy-handle=3',
+    ...args,
+  ], {
+    encoding: 'utf8',
+    stdio: ['ignore', 'pipe', 'pipe', manifestHandle, mountHandle],
+    ...options,
+  });
+  fs.closeSync(manifestHandle);
+  fs.closeSync(mountHandle);
+  return result;
+}
+
+const result = spawnWithManifest(JSON.stringify(validManifest), [
+  '--eval',
+  'process.stdout.write("ok\\n")',
+]);
+
+assert.strictEqual(result.status, 0);
+assert.strictEqual(result.stdout, 'ok\n');
+assert.strictEqual(result.stderr, '');
+
+for (const [manifest, error] of [
+  ['not json', /cannot parse hermetic policy manifest/],
+  [JSON.stringify({ ...validManifest, version: 2 }),
+    /unsupported hermetic policy manifest version/],
+]) {
+  const invalid = spawnWithManifest(manifest);
+  assert.strictEqual(invalid.status, 9);
+  assert.match(invalid.stderr, error);
+}
+
+const badHandle = spawnSync(process.execPath, [
+  '--hermetic-policy-handle=3',
+], { encoding: 'utf8' });
+assert.strictEqual(badHandle.status, 9);
+assert.match(badHandle.stderr, /cannot read hermetic policy manifest handle/);
+
+const scriptPath = tmpdir.resolve('script.js');
+fs.writeFileSync(scriptPath, 'process.stdout.write(process.argv[2]);');
+const appArgument = spawnSync(process.execPath, [
+  scriptPath,
+  '--hermetic-policy-handle=3',
+], { encoding: 'utf8' });
+assert.strictEqual(appArgument.status, 0);
+assert.strictEqual(appArgument.stdout, '--hermetic-policy-handle=3');
+
+const badMount = spawnWithManifest(JSON.stringify({
+  ...validManifest,
+  mounts: [{ ...validManifest.mounts[0], handle: 5 }],
+}));
+assert.strictEqual(badMount.status, 9);
+assert.match(badMount.stderr,
+             /mount handle must identify an open file descriptor/);
+
+const nodeOptions = spawnSync(process.execPath, ['--eval', '0'], {
+  encoding: 'utf8',
+  env: {
+    ...process.env,
+    NODE_OPTIONS: '--hermetic-policy-handle=3',
+  },
+});
+assert.strictEqual(nodeOptions.status, 9);
+assert.match(nodeOptions.stderr,
+             /--hermetic-policy-handle= is not allowed in NODE_OPTIONS/);
+
+const configPath = tmpdir.resolve('node-config.json');
+fs.writeFileSync(configPath, JSON.stringify({
+  nodeOptions: { 'hermetic-policy-handle': 3 },
+}));
+const config = spawnSync(process.execPath, [
+  `--experimental-config-file=${configPath}`,
+], { encoding: 'utf8' });
+assert.strictEqual(config.status, 9);
+assert.match(config.stderr,
+             /--hermetic-policy-handle= is not allowed in NODE_OPTIONS/);
+
+const missingEnvFile = tmpdir.resolve('missing.env');
+const earlyFailure = spawnWithManifest('not json', [
+  `--env-file=${missingEnvFile}`,
+]);
+assert.strictEqual(earlyFailure.status, 9);
+assert.match(earlyFailure.stderr, /cannot parse hermetic policy manifest/);
+assert.doesNotMatch(earlyFailure.stderr, /missing\.env/);

